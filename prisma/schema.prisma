// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPERUSER
}

model User {
  id               String                 @id @default(uuid())
  clerkId          String                 @unique
  email            String                 @unique
  firstName        String
  lastName         String
  employeeId       String?                @unique
  role             Role                   @default(USER)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  // Relations
  riceAdded        RiceStock[]            @relation("RiceAddedBy")
  distributionLogs EmployeeDistribution[] @relation("DistributionCreatedBy")
  stockLogs        RiceStockLog[]         @relation("StockCreatedBy")
}

model RiceStock {
  id            String                 @id @default(uuid())
  name          String                 @unique
  stockKg       Float
  reorderLevel  Float
  comment       String?
  pricePerKilo  Float?
  updatedAt     DateTime               @updatedAt
  addedBy       User                   @relation("RiceAddedBy", fields: [addedById], references: [clerkId])
  addedById     String
  distributions EmployeeDistribution[]
  stockLogs     RiceStockLog[]
}

model EmployeeDistribution {
  id          String    @id @default(uuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String
  rice        RiceStock @relation(fields: [riceId], references: [id])
  riceId      String
  quantityKg  Float
  comment     String?
  dateGiven   DateTime  @default(now())
  // User who created this distribution entry
  createdBy   User      @relation("DistributionCreatedBy", fields: [createdById], references: [clerkId])
  createdById String
  imageUrl    String?
}

model RiceStockLog {
  id         String      @id @default(uuid())
  rice       RiceStock   @relation(fields: [riceId], references: [id])
  riceId     String
  quantityKg Float
  price      Float
  action     StockAction
  comment    String?
  createdAt  DateTime    @default(now())

  // User who performed the action
  createdBy   User   @relation("StockCreatedBy", fields: [createdById], references: [clerkId])
  createdById String

  // Supplier
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
}

enum StockAction {
  ADD
  REMOVE
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLogs RiceStockLog[]
}

model Employee {
  id                    String                 @id @default(uuid())
  firstName             String
  lastName              String
  employeeId            String                 @unique
  phone                 String?
  active                Boolean                @default(true)
  // 👇 New relation to stipend QR stubs
  qrStubs               QRStub[]
  employeeDistributions EmployeeDistribution[]
}

model QRStub {
  id         String   @id @default(uuid())
  employeeId String
  month      Int // e.g., 8 for August
  year       Int // e.g., 2026
  redeemed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])
}
